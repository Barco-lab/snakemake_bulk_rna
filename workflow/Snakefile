import os
from datetime import datetime

from snakemake.utils import min_version

min_version("9.12")  # pathvars


configfile: workflow.source_path("../config/config.yaml")


# 每执行一次 snakemake 生成一个 logs/run_<时间>/，本次所有任务的 log、benchmark 都放在里面。
# 写入环境变量，保证同一次运行中派生的子进程使用同一个编号。
RUN_ID = os.environ.setdefault("SMK_RUN_ID", datetime.now().strftime("run_%Y%m%d_%H%M%S"))
RUN_DIR = f"logs/{RUN_ID}"


pathvars:
    logs=RUN_DIR,
    benchmarks=f"{RUN_DIR}/benchmarks",


include: "rules/common.smk"
include: "rules/preprocess.smk"
include: "rules/align.smk"
include: "rules/quant.smk"
include: "rules/bigwig.smk"
include: "rules/report.smk"


rule all:
    input:
        all_targets(),
    default_target: True


onstart:
    # 记录本次运行的配置、样本表、流程与软件版本（dry-run 不执行）
    record_run([ENV_MAIN, ENV_DEEPTOOLS, FASTQC_JAVA])


onsuccess:
    finish_run(log)
    print(
        "\n流程完成。主要结果:\n"
        "  results/tables/                     表达矩阵\n"
        "  results/qc/summary.tsv              QC 汇总\n"
        "  results/qc/report.html              QC 报告（概览、流程与参数、QC 汇总表）\n"
        "  results/qc/multiqc/multiqc_report.html\n"
        "  results/07_bigwig/                  bigwig\n"
        f"  {RUN_DIR}/        本次运行的 log、benchmarks.tsv\n"
    )


onerror:
    finish_run(log)
    print(
        f"\n流程出错：请查看上方报错的规则及其 log（{RUN_DIR}/<步骤>/<样本>.log）。"
        "修复后重新运行即可断点续跑。\n"
    )
